# Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_TELEGRAM_ID=your_admin_telegram_id_here

# Group chat ID for shared notifications (optional)
GROUP_CHAT_ID=-1001234567890

# Database URL
# Local SQLite default:
# DATABASE_URL=sqlite:///chorebot.db
# Or Supabase / Neon (PostgreSQL):
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# Webhook setting (Required when hosting on Render/Heroku with Webhooks)
# Leave empty for local polling mode!
# WEBHOOK_URL=https://your-app-name.onrender.com

# Timezone (e.g. Asia/Kolkata, UTC, America/New_York)
TIMEZONE=Asia/Kolkata

# Reminder timeout in minutes (how long before marking as missed)
REMINDER_TIMEOUT_MINUTES=60

# Schedule generation days ahead
SCHEDULE_DAYS_AHEAD=30
